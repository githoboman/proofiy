# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/botchain_proof

# BOT Chain Network Configuration
# ----------------------------------------------------------------------
# Testnet (Bohr Testnet):
# BOTCHAIN_RPC_URL=https://rpc.bohr.life
# BOTCHAIN_CHAIN_ID=968
# BOTCHAIN_EXPLORER_URL=https://scan.bohr.life
#
# Mainnet:
# BOTCHAIN_RPC_URL=https://rpc.botchain.ai
# BOTCHAIN_CHAIN_ID=677
# BOTCHAIN_EXPLORER_URL=https://scan.botchain.ai
# ----------------------------------------------------------------------
BOTCHAIN_RPC_URL=https://rpc.bohr.life
BOTCHAIN_CHAIN_ID=968
BOTCHAIN_EXPLORER_URL=https://scan.bohr.life

# Deployed Smart Contracts on BOT Chain
BOTCHAIN_PROVENANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BOTCHAIN_REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# BOT Chain Agent OS Integration (Optional)
BOTCHAIN_WALLET_API_URL=https://wallet-api.bohr.life
BOTCHAIN_IDENTITY_API_URL=https://identity-api.bohr.life
BOTCHAIN_API_KEY=ak_test_...

# CORS
CORS_ORIGIN=http://localhost:3000
